# Login screen branding. Compiled into the gdm dconf database by
# dconf-update.sh at build time.

[org/gnome/login-screen]
logo='/usr/share/icons/hicolor/64x64/apps/cyniva-logo.png'
banner-message-enable=true
banner-message-text='Cyniva Linux'
disable-user-list=false

# Set to true if you want the login screen to stop listing local users --
# relevant once these machines are domain-joined, since AD users will not
# appear in the list anyway.
