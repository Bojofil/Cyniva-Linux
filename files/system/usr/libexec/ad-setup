#!/usr/bin/env bash
# Per-machine Active Directory setup.
#
# Contains no domain-specific data, so it is safe in a public image.
#
# Usage:
#   sudo ad-setup <domain> <path-to-sssd-overrides.conf> [join-user]
#
# Environment:
#   HOSTNAME_PREFIX  Prefix for generated hostnames.  Default: CYN-WS
#   MACHINE_NAME     Skip generation, use this exact name.
#
# NOTE ON CONFIG HANDLING:
# `realm join` writes its own /etc/sssd/sssd.conf and will overwrite anything
# placed there beforehand. So the supplied file is installed as a drop-in at
# /etc/sssd/conf.d/10-local.conf INSTEAD. SSSD merges conf.d/*.conf over the
# main file, so your settings win while realm still does the heavy lifting.
#
# The drop-in must be 0600 and root-owned or SSSD refuses to start.

set -euo pipefail

DOMAIN="${1:-}"
CONF_SRC="${2:-}"
JOIN_USER="${3:-Administrator}"
HOSTNAME_PREFIX="${HOSTNAME_PREFIX:-CYN-WS}"

if [[ -z "$DOMAIN" || -z "$CONF_SRC" ]]; then
    echo "usage: ad-setup <domain> <path-to-sssd-overrides.conf> [join-user]" >&2
    exit 1
fi
[[ $EUID -eq 0 ]] || { echo "must be run as root" >&2; exit 1; }
[[ -f "$CONF_SRC" ]] || { echo "no such file: $CONF_SRC" >&2; exit 1; }

# ---------------------------------------------------------------------
# Discovery first -- fail loudly here rather than midway through a join
# ---------------------------------------------------------------------
echo "==> Discovering $DOMAIN"
if ! realm discover "$DOMAIN"; then
    echo "ERROR: cannot discover $DOMAIN." >&2
    echo "       Almost always DNS. Check that this machine resolves via a DC:" >&2
    echo "         resolvectl status | grep -A3 'DNS Servers'" >&2
    echo "         dig +short -t SRV _ldap._tcp.dc._msdcs.$DOMAIN" >&2
    exit 1
fi

# ---------------------------------------------------------------------
# Machine name
# ---------------------------------------------------------------------
generate_name() {
    printf '%s%04d' "$HOSTNAME_PREFIX" \
        "$(( $(od -An -N2 -tu2 < /dev/urandom) % 10000 ))"
}
name_taken() { getent hosts "$1.$DOMAIN" >/dev/null 2>&1; }

if [[ -n "${MACHINE_NAME:-}" ]]; then
    NEW_NAME="$MACHINE_NAME"
    echo "==> Using supplied machine name: $NEW_NAME"
else
    echo "==> Generating machine name"
    for attempt in {1..10}; do
        NEW_NAME="$(generate_name)"
        name_taken "$NEW_NAME" || break
        echo "    $NEW_NAME already resolves, retrying ($attempt/10)"
    done
    echo "    Selected: $NEW_NAME"
fi

if (( ${#NEW_NAME} > 15 )); then
    echo "ERROR: '$NEW_NAME' exceeds the 15-character NetBIOS limit." >&2
    exit 1
fi

echo "==> Setting hostname to $NEW_NAME.$DOMAIN"
hostnamectl set-hostname "$NEW_NAME.$DOMAIN"

# ---------------------------------------------------------------------
# Join
# ---------------------------------------------------------------------
echo "==> Joining $DOMAIN as $NEW_NAME"
realm join --verbose \
    --user="$JOIN_USER" \
    --computer-name="$NEW_NAME" \
    "$DOMAIN"

# ---------------------------------------------------------------------
# Layer the local config over what realm generated
# ---------------------------------------------------------------------
echo "==> Installing SSSD overrides to /etc/sssd/conf.d/10-local.conf"
mkdir -p /etc/sssd/conf.d
install -o root -g root -m 0600 "$CONF_SRC" /etc/sssd/conf.d/10-local.conf
chmod 0700 /etc/sssd/conf.d

echo "==> Restarting sssd"
systemctl restart sssd.service
sleep 2

# ---------------------------------------------------------------------
# Verify
# ---------------------------------------------------------------------
echo "==> Verifying"
if ! systemctl is-active --quiet sssd.service; then
    echo "ERROR: sssd failed to start. Your overrides may be invalid." >&2
    echo "       journalctl -u sssd -b" >&2
    exit 1
fi

sssctl domain-status "$DOMAIN" || true

if id "$JOIN_USER" >/dev/null 2>&1; then
    echo "    Directory lookups are working."
else
    echo "    WARNING: '$JOIN_USER' did not resolve." >&2
    echo "    Try: id $JOIN_USER@$DOMAIN" >&2
    echo "    Then: journalctl -u sssd -b" >&2
fi

echo
echo "Done. Machine is $NEW_NAME.$DOMAIN"
echo "If you cannot sudo as a domain user, add your AD group to /etc/sudoers.d/."
